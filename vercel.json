{
  "buildCommand": "cd ASPIDA/frontend && npm install && npm run build",
  "outputDirectory": "ASPIDA/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
